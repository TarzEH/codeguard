# Copy to .env, or let ./install.sh generate one with random credentials.
# .env is git-ignored — never commit real secrets.

# --- MongoDB ---------------------------------------------------------------
# Keep passwords alphanumeric: they are embedded in a connection URI, where
# punctuation would need percent-encoding.
MONGO_ROOT_USERNAME=codeguard_root
MONGO_ROOT_PASSWORD=change_me_root
MONGO_APP_USERNAME=codeguard_app
MONGO_APP_PASSWORD=change_me_app
MONGO_DB=codeguard

# --- HAProxy ---------------------------------------------------------------
HAPROXY_STATS_PASSWORD=change_me_stats

# --- Scaling ---------------------------------------------------------------
BACKEND_REPLICAS=1
MIN_REPLICAS=1
MAX_REPLICAS=12
SCALE_UP_AT=8
SCALE_DOWN_AT=2
AUTOSCALE_INTERVAL=15
AUTOSCALE_COOLDOWN=60

# --- Optional --------------------------------------------------------------
# NVD is an opt-in fallback; its keyword search is not version aware.
# NVD_FALLBACK_ENABLED=true
# NVD_API_KEY=
